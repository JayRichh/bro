{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "types": ["vite/client"],
    "paths": { "monaco-esm/*": ["./node_modules/monaco-editor/esm/vs/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.svelte"]
}
